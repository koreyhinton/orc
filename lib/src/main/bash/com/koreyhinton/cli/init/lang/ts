# TypeScript. orc init reads these settings (sourced; plain assignments only).
ORC_LANG_NAME="TypeScript"
ORC_LANG_FILE="main.ts"
ORC_LANG_FORMAT=""
ORC_LANG_IGNORE=("node_modules/" "/dist")
