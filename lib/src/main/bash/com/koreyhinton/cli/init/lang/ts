# folder; with none, orc init warns that the tool below makes them (it never
# runs the tool itself). Glob patterns are allowed.
ORC_LANG_PROJECT=("package.json" "tsconfig.json")
ORC_LANG_PROJECT_TOOL="npm init and npx tsc --init"
ORC_LANG_SKELETON='function main(): void {
    // snippets go here
}

main();'
